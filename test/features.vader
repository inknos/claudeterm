Execute (undo warns about no terminal, not unsupported):
  let g:circuit_provider = 'opencode'
  redir => output
  silent call circuit#undo()
  redir END
  Assert output =~# 'no active terminal'
  Assert output !~# 'not supported'

Execute (redo warns about no terminal, not unsupported):
  let g:circuit_provider = 'opencode'
  redir => output
  silent call circuit#redo()
  redir END
  Assert output =~# 'no active terminal'
  Assert output !~# 'not supported'

Execute (export warns about no terminal, not unsupported):
  let g:circuit_provider = 'opencode'
  redir => output
