Execute (warnings use echomsg and persist in :messages):
  let g:circuit_provider = 'opencode'
  redir => output
  silent call circuit#undo()
  redir END
  Assert output =~# 'no active terminal'
  Assert output =~# 'vim-circuit:', 'should have vim-circuit prefix'

Execute (plan_open creates a real file when no plan file exists):
  let g:circuit_provider = 'opencode'
  let g:circuit_plan_filename_format = 'testplan'
  " Use an absolute tmpdir as plan_dir so s:git_root() is not involved
  let g:_test_tmpdir = tempname()
  call mkdir(g:_test_tmpdir, 'p')
  " Patch the provider's plan_dir to our absolute tmpdir
  let g:_test_prov = circuit#providers#get('opencode')
  let g:_test_orig_plan_dir = g:_test_prov.plan_dir
  let g:_test_prov.plan_dir = g:_test_tmpdir
  call circuit#plan_open()
  " A real file must have been created and opened
  let g:_test_bname = bufname('%')
  Assert g:_test_bname =~# 'testplan\.md$',
        \ 'expected testplan.md, got: ' . g:_test_bname
  Assert filereadable(g:_test_bname), 'file should exist on disk'
  Assert getbufvar('%', '&buftype') ==# '', 'should be a normal file buffer'
  " Cleanup
  execute 'bdelete!'
  call delete(g:_test_bname)
  call delete(g:_test_tmpdir, 'd')
  let g:_test_prov.plan_dir = g:_test_orig_plan_dir
  unlet g:circuit_plan_filename_format g:_test_tmpdir g:_test_prov
        \ g:_test_orig_plan_dir g:_test_bname
