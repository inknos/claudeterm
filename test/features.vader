Execute (prompt is in subcommand completion list):
  let result = circuit#complete('pro', 'CTerm pro', 9)
  Assert index(result, 'prompt') >= 0

Execute (circuit#prompt exists and is callable):
  let g:circuit_provider = 'opencode'
  Assert exists('*circuit#prompt')

Execute (send_staged_ref bails when start_on_refsend is 0 and no terminal):
  let g:circuit_start_on = 0
  call circuit#clear_staged_refs()
  exec 'e' fnameescape(fnamemodify('test/vimrc', ':p'))
  call circuit#stage_ref(1, 1)
  redir => out
  silent call circuit#send_staged_ref()
  redir END
  Assert out =~# 'no active terminal'
  call circuit#clear_staged_refs()
  let g:circuit_start_on = 1
  bdelete!

Execute (send_staged_ref bails when per-command start_on_refsend is 0):
  let g:circuit_start_on = 1
  let g:circuit_start_on_refsend = 0
  call circuit#clear_staged_refs()
  exec 'e' fnameescape(fnamemodify('test/vimrc', ':p'))
  call circuit#stage_ref(1, 1)
  redir => out
  silent call circuit#send_staged_ref()
  redir END
  Assert out =~# 'no active terminal'
  call circuit#clear_staged_refs()
  unlet g:circuit_start_on_refsend
  bdelete!

Execute (refsend_switch_tab defaults to 0):
  Assert g:circuit_refsend_switch_tab ==# 0

